# 프로젝트 정보
PROJECT_NAME=TinoLife API
VERSION=1.0.0
DESCRIPTION=TinoLife Backend API

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS 설정 (쉼표로 구분된 오리진 목록)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 데이터베이스 설정 (동기 - Alembic용)
DATABASE_URL=postgresql://user:password@localhost:5432/tinolife

# 데이터베이스 설정 (비동기 - FastAPI용)
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tinolife

# JWT 설정
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
