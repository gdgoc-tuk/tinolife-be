# 프로젝트 정보
PROJECT_NAME=TinoLife API
VERSION=1.0.0
DESCRIPTION=TinoLife Backend API

# 서버 설정
HOST=0.0.0.0
APP_PORT=8000
PORT=8000
DEBUG=True

# CORS 설정 (쉼표로 구분된 오리진 목록)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL 설정 (Docker Compose용)
POSTGRES_USER=tinolife
POSTGRES_PASSWORD=tinolife123
POSTGRES_DB=tinolife
POSTGRES_PORT=5432

# 데이터베이스 설정 (동기 - Alembic용)
# Docker Compose 사용시: db 호스트 사용
# 로컬 개발시: localhost 호스트 사용
DATABASE_URL=postgresql://tinolife:tinolife123@db:5432/tinolife

# 데이터베이스 설정 (비동기 - FastAPI용)
ASYNC_DATABASE_URL=postgresql+asyncpg://tinolife:tinolife123@db:5432/tinolife

# JWT 설정
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP 설정 (이메일 전송)
# Gmail 사용 시: smtp.gmail.com, 587
# 2단계 인증 활성화 후 앱 비밀번호 생성 필요
# 개발 환경: Mailtrap, MailHog 등 사용 권장
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=TinoLife

# 공공데이터 API 설정
PUBLIC_DATA_API_KEY=your-public-data-api-key

# 이미지 업로드 설정
# USE_S3=False: 로컬 파일 시스템 사용
# USE_S3=True: S3 또는 MinIO 사용
USE_S3=False

# S3/MinIO 설정 (USE_S3=True 일 때 필요)
# AWS S3 사용 시: AWS_S3_ENDPOINT_URL 비워두기
# MinIO 사용 시: AWS_S3_ENDPOINT_URL=http://minio:9000 (Docker 내부)
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2

# MinIO 로컬 개발용 설정 예시
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_BUCKET=tinolife-images
# USE_S3=True
